# ============================================================================
# REZOLV Sibiu MVP — Production / Development Environment Template
# Copy to .env and fill in real values. NEVER commit .env or secret keys.
# ============================================================================

REZOLV_ENV=production
REZOLV_HOST=127.0.0.1
REZOLV_PORT=8787
REZOLV_PILOT_CITY=Sibiu
REZOLV_CUSTOM_DOMAIN=rezolv.ro
REZOLV_ORIGINS=https://rezolv.ro,https://www.rezolv.ro

# Authentication & Zero-Downtime Key Rotation
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
REZOLV_SECRET=
REZOLV_SECRET_PREVIOUS=
REZOLV_TOKEN_TTL=43200

# Spend Caps & Billing Alerts (Hard limits to prevent runaway cloud/API bills)
REZOLV_MONTHLY_SPEND_CAP_EUR=250.0
REZOLV_DAILY_SMS_CAP=500
REZOLV_DAILY_AI_CALLS_CAP=2000

# Database & Backups
REZOLV_DATA_DIR=./backend/data
REZOLV_BACKUP_DIR=./backend/backups

# Supabase / PostgreSQL (Production DB)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Anti-No-Show SMS Engine (24h & 2h Reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=REZOLV

# Transactional Email (SPF / DKIM / DMARC configured on rezolv.ro)
RESEND_API_KEY=
SMTP_HOST=
EMAIL_FROM=noreply@rezolv.ro
DKIM_SELECTOR=rezolv1

# AI Triage Engine (Primary LLM + Deterministic Fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
REZOLV_AI_MAX_INPUT_TOKENS=250

# Observability, Error Tracking & Alerting
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
ALERT_WEBHOOK_URL=
